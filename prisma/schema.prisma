// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider  = "postgresql"
}

// ==================== ENUMS ====================

enum UserRole {
  ADMIN
  MODERATOR
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CARD
  TRANSFER
  WALLET
  CASH_ON_DELIVERY
}

enum ProformaStatus {
  PENDIENTE
  COTIZADA
  ENVIADA
}

// ==================== MODELS ====================

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  password  String?
  name      String
  phone     String?
  avatar    String?
  role      UserRole   @default(CUSTOMER)
  status    UserStatus @default(ACTIVE)
  deletedAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  addresses Address[]
  orders    Order[]
  proformas Proforma[]

  @@map("users")
}

model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  icon      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@map("categories")
}

model Brand {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logo      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@map("brands")
}

model Product {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String?
  price        Decimal  @db.Decimal(10, 2)
  comparePrice Decimal? @db.Decimal(10, 2)
  stock        Int      @default(0)
  images       String[]
  specs        Json?
  isNew        Boolean  @default(false)
  isFeatured   Boolean  @default(false)
  isActive     Boolean  @default(true)
  showPrice    Boolean  @default(true)
  freeShipping Boolean  @default(false)
  returnPolicy Boolean  @default(false)
  returnDays   Int?
  warranty     Boolean  @default(false)
  warrantyPeriod String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  searchVector Unsupported("tsvector")?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id])

  orderItems OrderItem[]

  @@index([categoryId])
  @@index([brandId])
  @@index([slug])
  // Cubren los filtros reales de /api/products y src/lib/queries.ts:
  // listado general y "más vendidos" (isActive + orden por fecha),
  // destacados (isActive + isFeatured), ofertas (isActive + comparePrice).
  @@index([isActive, createdAt])
  @@index([isActive, isFeatured])
  @@index([isActive, comparePrice])
  @@map("products")
}

model Address {
  id        String   @id @default(cuid())
  label     String
  name      String
  phone     String
  address   String
  city      String
  state     String
  zipCode   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  orders Order[]

  @@index([userId])
  @@map("addresses")
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  status          OrderStatus @default(PENDING)
  subtotal        Decimal     @db.Decimal(10, 2)
  shipping        Decimal     @db.Decimal(10, 2)
  total           Decimal     @db.Decimal(10, 2)
  paymentMethod   String
  stripeSessionId String?
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  addressId String
  address   Address @relation(fields: [addressId], references: [id])

  items OrderItem[]

  @@index([userId])
  @@index([orderNumber])
  @@map("orders")
}

model OrderItem {
  id       String  @id @default(cuid())
  name     String
  price    Decimal @db.Decimal(10, 2)
  quantity Int
  total    Decimal @db.Decimal(10, 2)

  orderId String
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model Message {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("messages")
}

model Calculator {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  area        Decimal  @db.Decimal(10, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  materials   CalculatorMaterial[]
  proformas   Proforma[]

  @@map("calculators")
}

model CalculatorMaterial {
  id          String   @id @default(cuid())
  name        String
  unit        String
  yield       Decimal  @db.Decimal(10, 4)
  unitPrice   Decimal? @db.Decimal(10, 4)
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  calculatorId String
  calculator   Calculator @relation(fields: [calculatorId], references: [id], onDelete: Cascade)

  proformaItems ProformaItem[]

  @@index([calculatorId])
  @@map("calculator_materials")
}

model Proforma {
  id           String         @id @default(cuid())
  status       ProformaStatus @default(PENDIENTE)
  area         Decimal        @db.Decimal(10, 2)
  contactName  String?
  contactPhone String?
  contactEmail String?
  // RUC o cédula del cliente, solo para la proforma en PDF.
  contactDocument String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  // Papelera: si tiene fecha, la proforma está "eliminada" (oculta de la lista
  // normal) pero se conserva hasta que se purga automáticamente a los 30 días.
  deletedAt DateTime?

  // Ajuste (descuento o recargo) aplicado al total de la proforma completa,
  // por encima de la suma de sus materiales. No modifica el precio de cada
  // material individualmente.
  adjustmentType      String?
  adjustmentDirection String?
  adjustmentValue     Decimal? @db.Decimal(10, 4)

  // Se asignan la primera vez que se genera el PDF (validado con la clave del
  // vendedor) y ya no cambian de número; el nombre del local y del vendedor se
  // guardan aparte para que el historial no se pierda si luego se editan o
  // eliminan. No hay una tabla de "generaciones": el PDF se puede volver a
  // descargar las veces que haga falta con el mismo número.
  proformaNumber Int?
  branchId       String?
  branch         Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  branchName     String?
  sellerId       String?
  seller         Seller? @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  sellerName     String?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  calculatorId String
  calculator   Calculator @relation(fields: [calculatorId], references: [id])

  items ProformaItem[]

  @@index([userId])
  @@index([status])
  @@index([deletedAt])
  @@index([branchId])
  @@index([sellerId])
  @@map("proformas")
}

model ProformaItem {
  id        String   @id @default(cuid())
  name      String
  unit      String
  quantity  Decimal  @db.Decimal(10, 2)
  unitPrice Decimal? @db.Decimal(10, 4)
  position  Int      @default(0)

  // Valores al momento de crear la proforma (calculados por la calculadora, o
  // 1 si el material se agregó manualmente); no cambian después, sirven como
  // referencia para "ver original" y "restablecer".
  originalUnitPrice Decimal? @db.Decimal(10, 4)
  originalQuantity  Decimal  @default(1) @db.Decimal(10, 2)

  proformaId String
  proforma   Proforma @relation(fields: [proformaId], references: [id], onDelete: Cascade)

  materialId String?
  material   CalculatorMaterial? @relation(fields: [materialId], references: [id], onDelete: SetNull)

  @@index([proformaId])
  @@map("proforma_items")
}

// Local físico de la empresa. Cada local lleva su propio correlativo de
// número de proforma, empezando en 100000.
model Branch {
  id                  String   @id @default(cuid())
  name                String
  phone               String?
  address             String?
  active              Boolean  @default(true)
  nextProformaNumber  Int      @default(100000)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  sellers   Seller[]
  proformas Proforma[]

  @@map("branches")
}

// Vendedor de un local. La clave (PIN de 6 dígitos) se guarda con hash y solo
// sirve para autorizar la generación del PDF de una proforma a su nombre; no
// es una cuenta de acceso al panel admin.
model Seller {
  id        String   @id @default(cuid())
  name      String
  pinHash   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  proformas Proforma[]

  @@index([branchId])
  @@map("sellers")
}

// Valores de configuracion simples que el admin puede cambiar desde el panel
// (por ahora solo la clave de acceso a Locales/Vendedores). Si no hay fila
// para una clave, se usa el valor del .env como respaldo.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

model MediaItem {
  id        String   @id @default(cuid())
  name      String
  url       String
  publicId  String   @unique
  width     Int?
  height    Int?
  size      Int?
  folder    String   @default("general")
  createdAt DateTime @default(now())

  @@index([folder])
  @@map("media_items")
}

